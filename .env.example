# JWT signing secret (required for real use; a weak default is used if unset)
JWT_SECRET=change-me-to-a-long-random-string

# FastAPI
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Vite UI (run.py sets VITE_BACKEND_URL from BACKEND_* so /api proxies correctly)
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# SQLite (relative to repo root)
DB_PATH=data/studio.db

# Comma-separated allowed CORS origins (* allowed for same-origin Docker UI)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Built frontend directory (set automatically in Docker)
# STATIC_DIR=frontend/dist
